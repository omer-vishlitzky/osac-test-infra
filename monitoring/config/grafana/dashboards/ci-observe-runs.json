    {
      "title": "Request volume by service",
      "description": "Matched Beyla spans grouped by service, with the slowest span per service. Counts are of the spans returned by the search (Tempo caps 100 spans per spanset), so they rank services by activity rather than measure the exact totals.",
      "type": "table",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "traceService": { "aggregations": [], "operation": "groupby" },
              "spanID": { "aggregations": ["count"], "operation": "aggregate" },
              "duration": { "aggregations": ["max"], "operation": "aggregate" }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No service spans in this capture"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceService" },
            "properties": [{ "id": "displayName", "value": "Service" }]
          },
          {
            "matcher": { "id": "byName", "options": "spanID (count)" },
            "properties": [{ "id": "displayName", "value": "Spans" }]
          },
          {
            "matcher": { "id": "byName", "options": "duration (max)" },
            "properties": [{ "id": "displayName", "value": "Slowest span" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Spans", "desc": true }],
        "footer": { "show": false }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = nil}",
          "limit": 30000,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
