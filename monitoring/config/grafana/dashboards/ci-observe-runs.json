    {
      "title": "Node CPU usage (cores)",
      "description": "rate() of the kubelet node CPU time counter, collected every 60s during the capture. Kubelet metrics are not labeled with the capture id, so these panels show whatever the capture backend holds inside the dashboard time range: keep the 7d default to find the capture, then narrow the range to the run window.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "ci-observe-metrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(k8s_node_cpu_time_seconds_total[5m])",
          "legendFormat": "{{k8s_node_name}}",
          "refId": "A"
        }
      ]
    },
