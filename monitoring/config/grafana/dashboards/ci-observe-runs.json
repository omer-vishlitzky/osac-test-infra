{
  "annotations": {
    "list": []
  },
  "description": "Everything about one ci-observe E2E capture: pytest test spans, Beyla service-request spans, cluster/pod logs, and kubelet cluster metrics. Pick the capture with the Capture variable (Loki label osac_ci_capture_id, defaults to the newest). The default time range is 7 days because captures are imported asynchronously after the run finishes and keep their original timestamps. Tempo search returns at most 100 spans per spanset per trace, and a pytest session is a single trace, so test tables and counts cover the first 100 tests of larger runs. Kubelet metrics carry no capture-id label (the capture backend's Prometheus only promotes the k8s.* resource attributes), so the Cluster panels are scoped by the dashboard time range instead: narrow it to the run window shown by the Run duration stat.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Run overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Tests",
      "description": "Parent pytest test spans (pytest.span_type = test, phase spans ::setup/::call/::teardown excluded) in the selected capture. Tempo caps a spanset at 100 spans, so runs with more than 100 tests are undercounted.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"], "fields": "duration", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\"}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "Failed tests",
      "description": "Test spans with status = error (OTLP error status set by pytest-opentelemetry on failures).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["count"], "fields": "duration", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"test\" && name !~ \".*::(setup|call|teardown)\" && status = error}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "Run duration",
      "description": "Duration of the pytest 'test run' span. One per session; with pytest-xdist there is one per worker.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "tempo", "uid": "ci-observe-traces" },
      "fieldConfig": {
        "defaults": {
          "noValue": "No run span",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "duration", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.\"osac.ci.capture_id\" = \"$capture_id\" && .pytest.span_type = \"run\"}",
          "limit": 100,
          "spss": 100,
          "tableType": "spans"
        }
      ]
    },
    {
      "title": "Service spans",
      "description": "Beyla service-request spans (every span that is not a pytest span) returned by the search. Capped by Tempo's spanset and trace limits, so treat as a lower bound on large captures.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
