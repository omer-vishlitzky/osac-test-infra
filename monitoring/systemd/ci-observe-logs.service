# Hourly ci-observe artifact-log rollup.
# Installed by monitoring-setup.sh to ~/.config/systemd/user/ci-observe-logs.service
#
# Triggered by ci-observe-logs.timer. Each pass reads the artifact bundle of
# every in-scope suite run of the last 30 days (GitHub keeps artifacts 30
# days) whose latest attempt it has not read yet, at most 60 runs a pass
# (each costs two or three GitHub calls and a download; the token is shared
# with the exporter), newest first, and:
#   - failed runs: their error lines and failure-summary context go to Loki,
#     labeled by repository, suite and kind, with the run and the
#     normalized signature as structured metadata, where they outlive the
#     artifact and answer "what failed in this run";
#   - every run: its error signatures go to the artifact_log_signatures
#     table in trends.db, where failed and passing runs compare, and only
#     that comparison tells a cause from the noise every cluster logs.
# A run read once is not read again unless a newer attempt of it ran, so a
# pass after a quiet hour costs nothing; a backlog (a new deploy, a machine
# that was down) is worked off 60 runs an hour.
#
# The rollup runs inside the workflow-exporter container because that
# container already has the GitHub token, the `requests` dependency, the
# /data volume where trends.db lives, and network access to Loki. Do not
# enable it directly; the timer owns the schedule.
#
# Exit status 1 when GitHub or Loki refused the pass, or a bundle could not
# be read or was rejected (see the module docstring); a pass that ran to
# its end is recorded in trends.db's rollup_passes as "logs", which the
# pages and CiObserveHourlyStoreStale read.

[Unit]
Description=ci-observe artifact-log rollup (failed runs' logs into Loki)
After=workflow-exporter.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec workflow-exporter python3 /app/ci_observe_logs.py --days 30 --limit 60
